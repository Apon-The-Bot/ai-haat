{
  "name": "ai-haat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/db-env-guard.mjs --mode=dev",
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "db:guard": "node scripts/db-env-guard.mjs --mode=dev",
    "db:migrate:dev": "node scripts/db-env-guard.mjs --mode=dev-only && prisma migrate dev",
    "db:push": "node scripts/db-env-guard.mjs --mode=dev-only && prisma db push",
    "db:status": "prisma migrate status",
    "db:check": "node scripts/db-predeploy-check.mjs --require-backup",
    "db:deploy": "node scripts/db-predeploy-check.mjs --apply --require-backup",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "architecture:check": "node scripts/check-source-file-length.mjs",
    "backup:db": "npx tsx scripts/backup-production-db.ts",
    "backup:uploads": "npx tsx scripts/backup-uploads.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "autoprefixer": "^10.4.20",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.453.0",
    "next": "^15.5.29",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.1.4",
    "otpauth": "^9.5.1",
    "postcss": "^8.5.28",
    "prisma": "^5.19.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "playwright": "^1.62.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "postcss": "^8.5.28"
  }
}
