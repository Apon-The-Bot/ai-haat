# ─── AI Haat Environment Variables ────────────────────────
# Copy this file to .env.local and fill in real values

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/dbname

# ─── NextAuth ─────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# ─── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Admin Emails (comma-separated) ──────────────────────
ADMIN_EMAILS=admin@example.com

# ─── SMTP (Hostinger Business Email) ─────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ─── PipraPay Payment Gateway ────────────────────────────
PIPRAPAY_BASE_URL=https://pay.example.com
PIPRAPAY_API_KEY=
# PipraPay database URL for gateway management
PIPRAPAY_DATABASE_URL=

# ─── MFA & System Secrets (REQUIRED for production) ──────────────
# Generate: openssl rand -hex 32
MFA_ENCRYPTION_KEY=
# Generate: openssl rand -hex 32
EMAIL_OTP_PEPPER=
# Generate: openssl rand -hex 32 (MFA recovery code pepper)
MFA_RECOVERY_CODE_PEPPER=
# Generate: openssl rand -hex 32 (Cron bearer token authorization)
CRON_SECRET=
# Generate: openssl rand -hex 32 (Dedicated AES-256-GCM backup key)
BACKUP_ENCRYPTION_KEY=

# ─── Offsite Backup Storage (Optional — S3 / Cloudflare R2 / B2) ─
# BACKUP_STORAGE_PROVIDER=s3
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=aihaat-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto

# ─── Reverse Proxy & Rate Limiting ────────────────────────
# Set to 'true' only if deployed behind a trusted reverse proxy (e.g., Nginx, Cloudflare)
TRUST_PROXY=false
# Set to 'true' only if Cloudflare is directly in front of the origin
TRUST_CF_CONNECTING_IP=false

# ─── Site & Public URLs ─────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://aihaat.shop
NEXT_PUBLIC_SITE_URL=https://aihaat.shop
NEXT_PUBLIC_WHATSAPP_NUMBER=8801XXXXXXXXX

# ─── Notifications & Telegram Alerts (Optional) ────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
EMAIL_FROM="AI Haat" <noreply@aihaat.shop>

# ─── Analytics (Optional — site works without these) ─────────
# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta/Facebook Pixel
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API (Server-only — NEVER expose to browser)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Meta Test Events (temporary, for testing only)
# META_TEST_EVENT_CODE=
