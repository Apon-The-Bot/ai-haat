# ─── AI Haat Isolated Local Development Environment (.env.development.example) ───
# Copy this file to `.env` for local development so local commands NEVER touch
# the Hostinger production database (`u298980084_ai_haat`).
# Production credentials must remain solely in `production.env` or Hostinger hPanel.

NODE_ENV=development

# ─── Dedicated Local Development Database (Isolated User & Schema) ───────────────
DATABASE_URL=mysql://aihaat_dev:password@127.0.0.1:3306/aihaat_dev
DB_EXPECTED_TARGET="127.0.0.1/aihaat_dev"

# ─── Local NextAuth Configuration ───────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET=

# ─── Google OAuth (Use Separate Local Redirect URI Client in Dev) ───────────────
GOOGLE_CLIENT_ID="replace-with-dev-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=

# ─── Admin Emails (Dev Test Accounts Only) ──────────────────────────────────────

# ─── Local Development Cryptographic Keys (Deterministic Dev-Only Keys) ─────────
MFA_ENCRYPTION_KEY=
EMAIL_OTP_PEPPER=
MFA_RECOVERY_CODE_PEPPER=
DIGITAL_INVENTORY_ENCRYPTION_KEY=
CRON_SECRET=
BACKUP_ENCRYPTION_KEY=

# ─── Simulated / Sandbox Integrations in Development ────────────────────────────
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=
EMAIL_FROM="AI Haat Dev <noreply@localhost.test>"
PIPRAPAY_BASE_URL="http://localhost:3001/mock-payment"
PIPRAPAY_API_KEY=
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
NEXT_PUBLIC_BDT_PER_USD="130"
TRUST_PROXY="false"
TRUST_CF_CONNECTING_IP="false"
